# Frontend build-time vars (Vite). VITE_DOWNLOAD_URL points at the stable-name alias asset served
# from website/public/downloads/ (see scripts/release.ts "Publish stable-name aliases") — same
# origin as the site itself, so clicking Download never redirects anywhere and can't 404 due to a
# missing/unpublished external release, and always serves the latest build with no code change or
# redeploy needed here. Leave unset to use the "/downloads/..." default in src/config.ts.
VITE_DOWNLOAD_URL=/downloads/Argus-Setup-win-x64.exe

# Contact identity shown in the Navbar/Contact/Footer (see src/config.ts SITE). Company fields are
# optional — leave both blank to omit the "Company" footer link entirely.
VITE_CONTACT_EMAIL=sales@example.com
VITE_COMPANY_NAME=
VITE_COMPANY_URL=

# Serverless contact-form backend (api/contact.ts) — Microsoft Graph app-only auth.
# See README.md "Azure setup" for how to obtain these.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Mailbox the app sends AS (needs a real Microsoft 365 mailbox license).
MAIL_SENDER_UPN=
# Where the form's messages land. Should match VITE_CONTACT_EMAIL above. Defaults to sales@example.com if unset.
CONTACT_TO_EMAIL=

# License portal (/admin, never linked from the public site) — see GUIDE.md §9.5. Reuses the
# AZURE_* vars above to email issued licenses.
# The exact contents of secrets/license-private-key.pem (root repo) — must be the same keypair
# the exe verifies against, or licenses issued here won't apply. Never commit the real value.
LICENSE_PRIVATE_KEY_PEM=
# Generate with: bun run scripts/hash-admin-password.ts "a password" (run from the repo root).
ADMIN_PASSWORD_HASH=
# Any long random string, e.g. `openssl rand -hex 32` — signs the admin login session cookie.
ADMIN_SESSION_SECRET=
# Optional: a Vercel KV / Upstash Redis store's REST credentials. Without these, the portal still
# issues + emails licenses, just without an issuance history list or login rate-limiting.
KV_REST_API_URL=
KV_REST_API_TOKEN=
